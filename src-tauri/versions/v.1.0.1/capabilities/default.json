{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the physics-ide workspace",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "shell:default",
    {
      "identifier": "fs:allow-read",
      "allow": [{ "path": "$HOME/projects/physics-ide/**" }]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [{ "path": "$HOME/projects/physics-ide/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$HOME/projects/physics-ide/**" }]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "launch-editor",
          "cmd": "bash",
          "args": [
            "src-tauri/scripts/launch_editor.sh",
            { "validator": "\\S+" },
            { "validator": "\\S+" }
          ]
        }
      ]
    }
  ]
}
